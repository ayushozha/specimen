{
  "name": "@specimen/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc -p .",
    "postinstall": "wxt prepare",
    "build:e2e": "wxt build --mode e2e",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3"
  },
  "dependencies": {
    "@specimen/core": "workspace:*",
    "@specimen/exporters": "workspace:*",
    "ag-psd": "34.1.0",
    "culori": "4.0.2",
    "fflate": "0.8.3",
    "mediabunny": "1.65.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "6.0.3",
    "wxt": "0.21.5"
  }
}
